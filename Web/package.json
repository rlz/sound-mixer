{
    "name": "sound-mixer-web",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build && node scripts/prepare-local-html.mjs",
        "build:debug": "tsc --noEmit && NODE_ENV=development vite build --mode development && node scripts/prepare-local-html.mjs",
        "test": "node --test",
        "check": "npm run format:check && npm run lint && npm run build",
        "format:check": "prettier --check .",
        "format": "prettier --write .",
        "lint": "eslint src vite.config.ts scripts eslint.config.mjs"
    },
    "dependencies": {
        "@fortawesome/fontawesome-svg-core": "7.3.1",
        "@fortawesome/free-solid-svg-icons": "7.3.1",
        "@fortawesome/react-fontawesome": "3.5.0",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "zustand": "5.0.15"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@tailwindcss/vite": "4.3.3",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.1.1",
        "eslint": "10.11.0",
        "eslint-plugin-react-hooks": "7.1.1",
        "eslint-plugin-react-refresh": "0.5.7",
        "globals": "17.12.0",
        "prettier": "3.9.9",
        "prettier-plugin-tailwindcss": "0.8.1",
        "tailwindcss": "4.3.3",
        "typescript": "6.0.3",
        "typescript-eslint": "8.70.1",
        "vite": "8.3.1"
    }
}
